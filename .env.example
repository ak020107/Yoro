# Copy to .env.local. Never commit actual keys.
# preview uses explicitly labeled authored examples, never simulated AI scores.
PROVIDER_MODE=preview
GEMINI_API_KEY=
# Set an audio-capable model available in your Google AI Studio account.
GEMINI_MODEL=gemini-2.5-flash
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_US_VOICE_ID=
ELEVENLABS_UK_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_v3
ELEVENLABS_STT_MODEL=scribe_v2
BACKBOARD_API_KEY=
# Optional Atlas persistence. Local development otherwise uses private .data files.
MONGODB_URI=
MONGODB_DATABASE=voice_coach
# Server-side session credentials are HttpOnly. Keep local HTTP development false.
COOKIE_SECURE=false
# Must match the browser origin if serving through an HTTPS tunnel.
APP_ORIGIN=http://localhost:3000
# Vercel: store recordings in the existing Atlas database, never its temporary disk.
# Leave unset for local file-backed recordings.
AUDIO_STORAGE=
# Shared production demo cap, including retries; provider credits still apply.
DAILY_PROVIDER_REQUEST_LIMIT=200
